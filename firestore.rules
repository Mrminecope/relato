rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function profile(userId) { return get(/databases/$(database)/documents/profiles/$(userId)).data; }
    function self(userId) { return signedIn() && uid() == userId; }
    function adult(userId) { return exists(/databases/$(database)/documents/profiles/$(userId)) && profile(userId).age >= 18; }
    function minor(userId) { return exists(/databases/$(database)/documents/profiles/$(userId)) && profile(userId).age >= 16 && profile(userId).age < 18; }
    function modeAllowed(age, mode) { return mode == 'friendship' || (mode == 'dating' && age >= 18); }
    function publicKeys() { return ['id','alias','avatarSeed','age','isMinor','gender','country','heightCm','languages','interests','activeMode','allowedModes','osintFootprint','bio','lookingFor','createdAt','updatedAt']; }
    function osintKeys() { return ['publicGithub','publicScholar','publicBlogTopics','publicSubredditsOrForums','favoriteBooksAuthors','musicAesthetics','verifiedPublicSignals','osintSummary','consentGranted']; }

    match /profiles/{userId} {
      allow read: if self(userId);
      allow create: if self(userId)
        && request.resource.data.id == userId
        && request.resource.data.age >= 16
        && request.resource.data.gender in ['Male','Female']
        && modeAllowed(request.resource.data.age, request.resource.data.activeMode)
        && request.resource.data.allowedModes.hasOnly(['friendship','dating'])
        && (request.resource.data.age < 18 ? request.resource.data.allowedModes == ['friendship'] : request.resource.data.allowedModes.hasAll(['friendship','dating']));
      allow update: if self(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.age >= 16
        && request.resource.data.gender == resource.data.gender
        && modeAllowed(request.resource.data.age, request.resource.data.activeMode)
        && request.resource.data.allowedModes.hasOnly(['friendship','dating'])
        && (request.resource.data.age < 18 ? request.resource.data.allowedModes == ['friendship'] : request.resource.data.allowedModes.hasAll(['friendship','dating']))
        && request.resource.data.email == resource.data.email;
      allow delete: if self(userId);
    }

    match /public_profiles/{userId} {
      allow read: if signedIn() && userId != uid() && resource.data.isMinor == (profile(uid()).age < 18);
      allow create, update: if self(userId)
        && request.resource.data.keys().hasOnly(publicKeys())
        && request.resource.data.id == userId
        && request.resource.data.age >= 16
        && request.resource.data.isMinor == (request.resource.data.age < 18)
        && request.resource.data.gender in ['Male','Female']
        && modeAllowed(request.resource.data.age, request.resource.data.activeMode)
        && request.resource.data.allowedModes.hasOnly(['friendship','dating'])
        && (request.resource.data.age < 18 ? request.resource.data.allowedModes == ['friendship'] : request.resource.data.allowedModes.hasAll(['friendship','dating']))
        && request.resource.data.osintFootprint.keys().hasOnly(osintKeys())
        && request.resource.data.osintFootprint.consentGranted == true
        && !('privacy' in request.resource.data)
        && !('email' in request.resource.data)
        && !('hasActiveDatingConnection' in request.resource.data)
        && !('activeDatingConnectionId' in request.resource.data);
      allow delete: if self(userId);
    }

    match /preferences/{userId} {
      allow read: if self(userId);
      allow create, update: if self(userId) && request.resource.data.keys().hasOnly(['ageMin','ageMax','modes','preferredGenders','countries','languages','interests','minCompatibilityScore']);
      allow delete: if self(userId);
    }

    match /dating_locks/{userId} {
      allow read: if self(userId);
      allow write: if false;
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUserId == uid() || resource.data.toUserId == uid());
      allow create: if signedIn()
        && request.resource.data.id == requestId
        && request.resource.data.fromUserId == uid()
        && request.resource.data.toUserId != uid()
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.toUserId))
        && profile(uid()).age >= 16
        && profile(request.resource.data.toUserId).age >= 16
        && request.resource.data.fromUserAge == profile(uid()).age
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['friend','chat']
        && request.resource.data.mode == (request.resource.data.type == 'friend' ? 'friendship' : 'dating')
        && (
          (minor(uid()) && minor(request.resource.data.toUserId) && request.resource.data.mode == 'friendship')
          || (adult(uid()) && adult(request.resource.data.toUserId) && modeAllowed(profile(uid()).age, request.resource.data.mode))
        );
      allow update: if signedIn()
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.type == resource.data.type
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.fromUserAge == resource.data.fromUserAge
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.toUserId == uid() && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined'])
          || (resource.data.fromUserId == uid() && resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
        );
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && uid() in resource.data.participantIds;
      allow create, update, delete: if false;
      match /messages/{messageId} {
        allow read, create: if signedIn()
          && exists(/databases/$(database)/documents/matches/$(matchId))
          && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.participantIds
          && get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'active'
          && (request.resource.data.matchId == matchId)
          && (request.resource.data.senderId == uid())
          && (request.resource.data.text is string)
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid() && request.resource.data.blockedUserId != uid();
      allow delete: if signedIn() && resource.data.userId == uid();
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid() && request.resource.data.reportedUserId != uid();
      allow read: if signedIn() && resource.data.reporterId == uid();
      allow update, delete: if false;
    }

    match /user_oauth/{userId} {
      allow read, write: if false;
    }
  }
}